{
  "name": "quillweave",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "check": "npm run check:size && npm run check --workspace=frontend",
    "check:size": "node scripts/check-source-size.mjs",
    "backend": "go run ./cmd/preview",
    "desktop": "node scripts/desktop.mjs",
    "bundle": "node scripts/build.mjs",
    "test": "node test/run.mjs go",
    "test:core": "node test/run.mjs core",
    "test:ui": "node test/run.mjs ui",
    "test:midscene": "node test/run.mjs midscene",
    "check:test-layout": "node --test test/runner/layout.test.mjs test/runner/build.test.mjs && node test/run.mjs layout",
    "bundle:windows": "node scripts/build.mjs windows",
    "test:race": "node test/run.mjs race",
    "check:go": "node test/run.mjs vet",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT"
}
